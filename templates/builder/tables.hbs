<section class="seb-tab" id="seb-panel-tables" role="tabpanel" aria-labelledby="seb-tab-tables" data-tab="tables">
  {{#unless ready}}
  <div class="seb-empty seb-gate"><i class="fa-solid fa-lock"></i><p class="seb-empty-title">{{gate.title}}</p><p class="seb-empty-hint">{{gate.hint}}</p></div>
  {{else}}
  <div class="seb-columns">
    <div class="seb-panel">
      <div class="seb-panel-head">
        <span class="seb-eyebrow">{{localize "sargas-encounter-builder.tables.title"}}</span>
        <span class="seb-panel-actions">
          <button type="button" class="seb-button seb-button-small" data-action="ext" data-ext="tables" data-method="createTable"><i class="fa-solid fa-plus"></i> {{localize "sargas-encounter-builder.tables.create"}}</button>
        </span>
      </div>
      <div class="seb-field">
        <label for="seb-table-select">{{localize "sargas-encounter-builder.tables.choose"}}</label>
        <select id="seb-table-select" name="tables.selected">
          <option value="">—</option>
          {{#each tables.tables}}<option value="{{this.uuid}}" {{#if this.selected}}selected{{/if}}>{{this.name}} ({{this.formula}}){{#if this.configured}} ★{{/if}}</option>{{/each}}
        </select>
      </div>
      <div class="seb-dropzone" data-purpose="table"><i class="fa-solid fa-hand-pointer"></i> {{localize "sargas-encounter-builder.tables.dropHint"}}</div>
      <div class="seb-toolbar">
        <button type="button" class="seb-button seb-button-primary" data-action="ext" data-ext="tables" data-method="roll" {{#unless tables.canRoll}}disabled{{/unless}}><i class="fa-solid fa-dice-d20"></i> {{localize "sargas-encounter-builder.tables.roll"}}</button>
        <button type="button" class="seb-button seb-button-small" data-action="ext" data-ext="tables" data-method="openEditor" {{#unless tables.selected}}disabled{{/unless}}><i class="fa-solid fa-pen"></i> {{localize "sargas-encounter-builder.tables.edit"}}</button>
        <button type="button" class="seb-button seb-button-small" data-action="ext" data-ext="tables" data-method="validate" {{#unless tables.selected}}disabled{{/unless}}><i class="fa-solid fa-check"></i> {{localize "sargas-encounter-builder.tables.validate"}}</button>
      </div>
      <p class="seb-hint">{{localize "sargas-encounter-builder.tables.rollHint"}}</p>
      {{#if tables.report}}
      <div class="seb-group-header"><span>{{localize "sargas-encounter-builder.tables.trace"}}</span></div>
      <pre class="seb-trace seb-scroll">{{tables.report.trace}}</pre>
      {{/if}}
    </div>
    <div class="seb-panel seb-panel-raised">
      <div class="seb-panel-head"><span class="seb-eyebrow">{{localize "sargas-encounter-builder.tables.result"}}{{#if tables.report}} <span class="seb-text-dim">· {{tables.report.tableName}}</span>{{/if}}</span></div>
      {{#if tables.report}}
        {{#unless tables.report.encounterOccurred}}<div class="seb-note"><i class="fa-solid fa-moon"></i> {{localize "sargas-encounter-builder.tables.noEncounter"}}</div>{{/unless}}
        {{#if tables.report.replacementWarning}}<div class="seb-note is-warn">{{localize "sargas-encounter-builder.tables.replacementWarning"}}</div>{{/if}}
        {{#each tables.report.errors}}<div class="seb-note is-error">{{this}}</div>{{/each}}
        {{#if tables.report.stoppedByLimit}}<div class="seb-note is-error">{{localize "sargas-encounter-builder.tables.stoppedByLimit"}}</div>{{/if}}
        <div class="seb-scroll seb-list">
          {{#each tables.report.creatures}}
          <div class="seb-row seb-creature">
            <img class="seb-portrait" src="{{#if this.img}}{{this.img}}{{else}}icons/svg/mystery-man.svg{{/if}}" alt="">
            <div class="seb-row-main"><span class="seb-row-name">{{this.name}}</span><span class="seb-row-meta">{{localize "sargas-encounter-builder.build.levelShort" level=this.levelLabel}}</span></div>
            <div class="seb-row-controls"><span class="seb-pill is-level">× {{this.quantity}}</span></div>
          </div>
          {{/each}}
          {{#each tables.report.unavailable}}<div class="seb-note is-error">{{localize "sargas-encounter-builder.tables.unavailable" uuid=this.uuid quantity=this.quantity}}</div>{{/each}}
          {{#each tables.report.narratives}}<div class="seb-note"><strong>{{this.kindLabel}}</strong> — {{this.text}}{{#if this.notes}} <span class="seb-text-dim">({{this.notes}})</span>{{/if}}{{#if this.journalUuid}} <a class="content-link" data-uuid="{{this.journalUuid}}"><i class="fa-solid fa-book"></i></a>{{/if}}</div>{{/each}}
          {{#each tables.report.templates}}<div class="seb-note"><strong>{{localize "sargas-encounter-builder.tables.templateRow"}}</strong> — {{this.text}} <span class="seb-text-dim">({{this.candidates}} {{localize "sargas-encounter-builder.tables.candidates"}}{{#if this.traits}}, {{this.traits}}{{/if}})</span></div>{{/each}}
          {{#each tables.report.notes}}<div class="seb-note"><i class="fa-solid fa-note-sticky"></i> {{this}}</div>{{/each}}
        </div>
        {{#if tables.report.classicEvaluation}}
        <div class="seb-result">
          <span class="seb-pill">{{tables.report.classicEvaluation.supportedXP}} XP</span>
          <span class="seb-pill is-accent">{{tables.report.classicEvaluation.inferredLabel}}</span>
          {{#unless tables.report.classicEvaluation.complete}}<span class="seb-pill is-warn">{{localize "sargas-encounter-builder.evaluation.incomplete"}}</span>{{/unless}}
        </div>
        {{#each tables.report.classicEvaluation.warnings}}<div class="seb-note is-warn">{{this}}</div>{{/each}}
        {{/if}}
        <div class="seb-toolbar seb-toolbar-wrap">
          <button type="button" class="seb-button seb-button-primary" data-action="ext" data-ext="tables" data-method="applyClassic" {{#unless tables.report.hasCreatures}}disabled{{/unless}}><i class="fa-solid fa-scroll"></i> {{localize "sargas-encounter-builder.tables.applyClassic"}}</button>
          <button type="button" class="seb-button" data-action="ext" data-ext="tables" data-method="createVariant" {{#unless tables.report.hasCreatures}}disabled{{/unless}}><i class="fa-solid fa-scale-balanced"></i> {{localize "sargas-encounter-builder.tables.createVariant"}}</button>
          <button type="button" class="seb-button" data-action="ext" data-ext="tables" data-method="applyTemplate" {{#unless tables.report.hasTemplates}}disabled{{/unless}}><i class="fa-solid fa-wand-magic-sparkles"></i> {{localize "sargas-encounter-builder.tables.applyTemplate"}}</button>
        </div>
        {{#unless tables.report.hasTemplates}}<p class="seb-hint">{{localize "sargas-encounter-builder.tables.notScalable"}}</p>{{/unless}}
      {{else}}
        <div class="seb-empty"><i class="fa-solid fa-dice-d20"></i><p class="seb-empty-title">{{localize "sargas-encounter-builder.tables.emptyTitle"}}</p><p class="seb-empty-hint">{{localize "sargas-encounter-builder.tables.empty"}}</p></div>
      {{/if}}
    </div>
  </div>
  {{/unless}}
</section>
