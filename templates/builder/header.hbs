{{!-- Party strip: who is fighting, at what level, against which threat. Always visible.
     One root element: ApplicationV2 parts must render exactly one. --}}
<div class="seb-header">
<header class="seb-strip">
  <div class="seb-strip-party">
    <span class="seb-eyebrow">{{localize "sargas-encounter-builder.header.party"}}</span>
    <div class="seb-strip-row">
      <button type="button" class="seb-party-button" data-action="changeParty" data-tooltip="{{localize 'sargas-encounter-builder.header.changeParty'}}">
        <i class="fa-solid fa-users"></i>
        <span class="seb-party-name">{{header.partyName}}</span>
        {{#if header.sourceLabel}}<span class="seb-pill">{{header.sourceLabel}}</span>{{/if}}
        <i class="fa-solid fa-chevron-down seb-party-caret"></i>
      </button>
      {{#if header.hasParty}}
      <span class="seb-stat" data-tooltip="{{localize 'sargas-encounter-builder.header.participating'}}"><i class="fa-solid fa-user-group"></i> {{header.participating}}</span>
      <span class="seb-stat" data-tooltip="{{localize 'sargas-encounter-builder.header.levels'}}"><i class="fa-solid fa-signal"></i> {{header.levels}}</span>
      <span class="seb-stat" data-tooltip="{{localize 'sargas-encounter-builder.header.reference'}}{{#if header.policy}} · {{header.policy}}{{/if}}"><i class="fa-solid fa-bullseye"></i> {{localize "sargas-encounter-builder.header.referenceShort"}} {{header.referenceLevel}}{{#if header.isEstimate}}<sup>*</sup>{{/if}}</span>
      {{#if header.missing}}<span class="seb-stat is-warn" data-tooltip="{{localize 'sargas-encounter-builder.header.missingTooltip'}}"><i class="fa-solid fa-triangle-exclamation"></i> {{header.missing}}</span>{{/if}}
      {{/if}}
    </div>
  </div>
  <div class="seb-strip-threat">
    <span class="seb-eyebrow">{{localize "sargas-encounter-builder.header.threat"}}{{#if header.target}} <span class="seb-eyebrow-value">{{header.target}} XP</span>{{/if}}</span>
    <div class="seb-segments" role="group" aria-label="{{localize 'sargas-encounter-builder.header.threat'}}">
      {{#each header.threats}}
      <button type="button" class="seb-segment{{#if this.active}} is-active{{/if}}" data-action="setThreat" data-value="{{this.value}}" aria-pressed="{{#if this.active}}true{{else}}false{{/if}}" data-tooltip="{{this.target}}" {{#if this.disabled}}disabled{{/if}}>{{this.label}}</button>
      {{/each}}
    </div>
  </div>
</header>
{{#if header.pwol}}
<div class="seb-note {{#if header.variantUnsupported}}is-warn{{/if}}"><i class="fa-solid fa-flask"></i> {{#if header.systemCalculation}}{{localize "sargas-encounter-builder.evaluation.pwolSystem"}}{{else}}{{localize "sargas-encounter-builder.evaluation.pwolUnsupported"}}{{/if}}</div>
{{/if}}
{{#each header.blockers}}<div class="seb-note is-error"><i class="fa-solid fa-circle-exclamation"></i> {{this}}</div>{{/each}}
{{#each messages}}<div class="seb-note seb-message is-{{this.level}}" role="{{#if (eq this.level "error")}}alert{{else}}status{{/if}}"><span class="seb-message-text">{{this.text}}</span><button type="button" class="seb-icon-button seb-message-dismiss" data-action="dismissMessage" data-id="{{this.id}}" data-tooltip="{{localize 'sargas-encounter-builder.app.dismiss'}}" aria-label="{{localize 'sargas-encounter-builder.app.dismiss'}}"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button></div>{{/each}}
</div>
