<section class="seb-tab" id="seb-panel-build" role="tabpanel" aria-labelledby="seb-tab-build" data-tab="build">
  {{#unless ready}}
  <div class="seb-empty seb-gate"><i class="fa-solid fa-lock"></i><p class="seb-empty-title">{{gate.title}}</p><p class="seb-empty-hint">{{gate.hint}}</p><button type="button" class="seb-button seb-button-primary" data-action="changeParty"><i class="fa-solid fa-dragon"></i> {{localize "sargas-encounter-builder.party.startDialog"}}</button></div>
  {{else}}
  <div class="seb-columns">
    <div class="seb-panel">
      <div class="seb-panel-head">
        <div class="seb-segments" role="group" aria-label="{{localize 'sargas-encounter-builder.build.modeLabel'}}">
          <button type="button" class="seb-segment{{#if build.isGenerate}} is-active{{/if}}" data-action="setBuildMode" data-value="generate" aria-pressed="{{#if build.isGenerate}}true{{else}}false{{/if}}"><i class="fa-solid fa-dice"></i> {{localize "sargas-encounter-builder.build.modeGenerate"}}</button>
          <button type="button" class="seb-segment{{#if build.isBrowse}} is-active{{/if}}" data-action="setBuildMode" data-value="browse" aria-pressed="{{#if build.isBrowse}}true{{else}}false{{/if}}"><i class="fa-solid fa-magnifying-glass"></i> {{localize "sargas-encounter-builder.build.modeBrowse"}}</button>
        </div>
        <span class="seb-panel-actions">
          <details class="seb-popover">
            <summary class="seb-button seb-button-small" data-tooltip="{{localize 'sargas-encounter-builder.build.packs'}}"><i class="fa-solid fa-book"></i> {{build.packCount}}</summary>
            <div class="seb-popover-body">
              <div class="seb-group-header"><span>{{localize "sargas-encounter-builder.build.packs"}}</span><button type="button" class="seb-icon-button" data-action="refreshCatalog" data-tooltip="{{localize 'sargas-encounter-builder.build.refresh'}}" aria-label="{{localize 'sargas-encounter-builder.build.refresh'}}" {{#if busy}}disabled{{/if}}><i class="fa-solid fa-rotate"></i></button></div>
              {{#each build.packs}}
              <label class="seb-checkbox"><input type="checkbox" name="pack" data-pack-id="{{this.id}}" {{#if this.selected}}checked{{/if}} {{#unless this.accessible}}disabled{{/unless}}> <span>{{this.label}} <span class="seb-text-dim">· {{this.packageName}} · {{this.stateLabel}}</span></span></label>
              {{/each}}
              {{#each build.missingPacks}}<div class="seb-note is-warn">{{localize "sargas-encounter-builder.build.packState.missingId" id=this}}</div>{{/each}}
            </div>
          </details>
        </span>
      </div>

      {{#if build.isGenerate}}
        {{> "modules/sargas-encounter-builder/templates/builder/generator.hbs"}}
      {{/if}}

      <div class="seb-filters{{#if build.isGenerate}} is-compact{{/if}}">
        {{#if build.isBrowse}}
        <div class="seb-field seb-field-wide">
          <label for="seb-build-search">{{localize "sargas-encounter-builder.build.search"}}</label>
          <div class="seb-search-wrap"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" id="seb-build-search" name="filter.search" value="{{build.filter.search}}" placeholder="{{localize 'sargas-encounter-builder.build.searchPlaceholder'}}" autocomplete="off"></div>
        </div>
        <div class="seb-field seb-field-short"><label for="seb-build-relmin">{{localize "sargas-encounter-builder.build.relativeMin"}}</label><input type="number" id="seb-build-relmin" name="filter.relativeMin" value="{{build.filter.relativeMin}}"></div>
        <div class="seb-field seb-field-short"><label for="seb-build-relmax">{{localize "sargas-encounter-builder.build.relativeMax"}}</label><input type="number" id="seb-build-relmax" name="filter.relativeMax" value="{{build.filter.relativeMax}}"></div>
        {{/if}}
        <div class="seb-field"><label for="seb-build-traits">{{localize "sargas-encounter-builder.build.traits"}}</label><input type="text" id="seb-build-traits" name="filter.traits" value="{{build.traits}}" placeholder="undead, fire"></div>
        <div class="seb-field"><label for="seb-build-tags">{{localize "sargas-encounter-builder.build.tags"}}</label><input type="text" id="seb-build-tags" name="filter.tags" value="{{build.tags}}" list="seb-tag-list" placeholder="environment:forest"><datalist id="seb-tag-list">{{#each build.allTags}}<option value="{{this}}"></option>{{/each}}</datalist></div>
        <div class="seb-field seb-field-wide">
          <label id="seb-build-rarity-label">{{localize "sargas-encounter-builder.build.rarity"}}</label>
          <div class="seb-chips" role="group" aria-labelledby="seb-build-rarity-label">{{#each build.rarities}}<button type="button" class="seb-chip{{#if this.active}} is-active{{/if}}" data-action="setRarity" data-value="{{this.value}}" aria-pressed="{{#if this.active}}true{{else}}false{{/if}}">{{this.label}}</button>{{/each}}</div>
        </div>
      </div>

      {{#if build.isBrowse}}
      <div class="seb-group-header seb-sticky"><span>{{localize "sargas-encounter-builder.build.catalog"}}</span><span class="seb-text-dim seb-catalog-count">{{build.resultCount}}</span></div>
      <div class="seb-scroll seb-list seb-catalog-list">{{> "modules/sargas-encounter-builder/templates/builder/catalog-list.hbs"}}</div>
      {{/if}}
    </div>

    <div class="seb-panel seb-panel-raised">
      <div class="seb-panel-head">
        <span class="seb-eyebrow">{{localize "sargas-encounter-builder.build.encounter"}} <span class="seb-text-dim">· {{build.draftCount}}</span></span>
        <span class="seb-panel-actions">
          <button type="button" class="seb-icon-button seb-icon-danger" data-action="clearDraft" data-tooltip="{{localize 'sargas-encounter-builder.build.clear'}}" aria-label="{{localize 'sargas-encounter-builder.build.clear'}}" {{#unless build.hasDraft}}disabled{{/unless}}><i class="fa-solid fa-eraser"></i></button>
        </span>
      </div>
      {{#if build.meter}}{{> "modules/sargas-encounter-builder/templates/builder/meter.hbs" meter=build.meter}}{{/if}}
      <div class="seb-scroll seb-list">
        {{#each build.draft}}
        <div class="seb-row seb-creature{{#if this.locked}} is-locked{{/if}}" data-uuid="{{this.uuid}}">
          <img class="seb-portrait" src="{{#if this.img}}{{this.img}}{{else}}icons/svg/mystery-man.svg{{/if}}" alt="">
          <div class="seb-row-main">
            <span class="seb-row-name">{{this.name}}{{#if this.statusLabel}} <span class="seb-pill is-warn">{{this.statusLabel}}</span>{{/if}}</span>
            <span class="seb-row-meta">{{localize "sargas-encounter-builder.build.levelShort" level=this.level}} <span class="seb-text-dim">({{this.relative}})</span>{{#if (ne this.xpEach null)}} · {{this.xpEach}} XP{{/if}}{{#if (ne this.subtotal null)}} · <strong>{{this.subtotal}} XP</strong>{{/if}}</span>
          </div>
          <div class="seb-row-controls">
            <input class="seb-qty" type="number" name="quantity" min="0" value="{{this.quantity}}" aria-label="{{localize 'sargas-encounter-builder.build.qty'}}">
            <button type="button" class="seb-icon-button{{#if this.locked}} is-active{{/if}}" data-action="lockCreature" data-tooltip="{{localize 'sargas-encounter-builder.build.lock'}}" aria-label="{{localize 'sargas-encounter-builder.build.lock'}}" aria-pressed="{{#if this.locked}}true{{else}}false{{/if}}"><i class="fa-solid {{#if this.locked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button>
            <button type="button" class="seb-icon-button" data-action="replaceEntry" data-tooltip="{{localize 'sargas-encounter-builder.generator.replace'}}" aria-label="{{localize 'sargas-encounter-builder.generator.replace'}}" {{#if this.locked}}disabled{{/if}}><i class="fa-solid fa-shuffle"></i></button>
            <button type="button" class="seb-icon-button" data-action="inspectCreature" data-tooltip="{{localize 'sargas-encounter-builder.build.inspect'}}" aria-label="{{localize 'sargas-encounter-builder.build.inspect'}}"><i class="fa-solid fa-eye"></i></button>
            <button type="button" class="seb-icon-button seb-icon-danger" data-action="removeCreature" data-tooltip="{{localize 'sargas-encounter-builder.build.remove'}}" aria-label="{{localize 'sargas-encounter-builder.build.remove'}}"><i class="fa-solid fa-xmark"></i></button>
          </div>
        </div>
        {{else}}
        <div class="seb-dropzone seb-dropzone-tall" data-purpose="draft"><i class="fa-solid fa-skull"></i><p class="seb-empty-title">{{localize "sargas-encounter-builder.build.emptyDraftTitle"}}</p><p class="seb-empty-hint">{{localize "sargas-encounter-builder.build.emptyDraft"}}</p></div>
        {{/each}}
        {{#if build.hasDraft}}<div class="seb-dropzone" data-purpose="draft"><i class="fa-solid fa-hand-pointer"></i> {{localize "sargas-encounter-builder.build.dropHint"}}</div>{{/if}}
      </div>
      <div class="seb-toolbar seb-toolbar-end">
        <button type="button" class="seb-button seb-button-small" data-action="ext" data-ext="saved" data-method="saveCurrent" {{#unless build.hasDraft}}disabled{{/unless}}><i class="fa-solid fa-floppy-disk"></i> {{localize "sargas-encounter-builder.saved.saveCurrent"}}</button>
        <button type="button" class="seb-button seb-button-primary seb-button-small" data-action="selectTab" data-tab="deploy" {{#unless build.hasDraft}}disabled{{/unless}}><i class="fa-solid fa-chess-knight"></i> {{localize "sargas-encounter-builder.build.toDeploy"}}</button>
      </div>
    </div>
  </div>
  {{/unless}}
</section>
