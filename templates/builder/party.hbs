<section class="seb-tab" id="seb-panel-party" role="tabpanel" aria-labelledby="seb-tab-party" data-tab="party">
  <div class="seb-columns seb-columns-narrow-left">
    <aside class="seb-panel">
      <div class="seb-panel-head">
        <span class="seb-eyebrow">{{localize "sargas-encounter-builder.party.profiles"}}</span>
        <span class="seb-panel-actions">
          <button type="button" class="seb-button seb-button-small" data-action="changeParty"><i class="fa-solid fa-dragon"></i> {{localize "sargas-encounter-builder.party.startDialog"}}</button>
          <button type="button" class="seb-button seb-button-primary seb-button-small" data-action="createProfile"><i class="fa-solid fa-plus"></i> {{localize "sargas-encounter-builder.party.create"}}</button>
        </span>
      </div>
      <div class="seb-scroll">
        {{#if party.partyActors.length}}
        <div class="seb-group-header"><span>{{localize "sargas-encounter-builder.party.partyActors"}}</span><span class="seb-text-dim">{{party.partyActors.length}}</span></div>
        {{#each party.partyActors}}
        <div class="seb-row seb-row-click" role="button" tabindex="0" data-action="linkPartyActor" data-uuid="{{this.uuid}}">
          <i class="fa-solid fa-people-group seb-row-icon"></i>
          <div class="seb-row-main"><span class="seb-row-name">{{this.name}}</span><span class="seb-row-meta">{{localize "sargas-encounter-builder.party.partyActorHint"}}</span></div>
          <div class="seb-row-controls"><i class="fa-solid fa-link seb-text-dim"></i></div>
        </div>
        {{/each}}
        {{/if}}
        <div class="seb-group-header"><span>{{localize "sargas-encounter-builder.party.savedProfiles"}}</span><span class="seb-text-dim">{{party.profiles.length}}</span></div>
        {{#each party.profiles}}
        <div class="seb-row seb-row-click{{#if this.selected}} is-selected{{/if}}" role="button" tabindex="0"{{#if this.selected}} aria-current="true"{{/if}} data-action="selectProfile" data-id="{{this.id}}">
          <i class="fa-solid {{#if (eq this.kind "linked")}}fa-link{{else}}fa-users{{/if}} seb-row-icon"></i>
          <div class="seb-row-main"><span class="seb-row-name">{{this.name}}</span><span class="seb-row-meta">{{this.kindLabel}}{{#unless (eq this.kind "linked")}} · {{localize "sargas-encounter-builder.party.memberCount" count=this.count}}{{/unless}}</span></div>
        </div>
        {{else}}
        <div class="seb-empty seb-empty-compact"><i class="fa-solid fa-users"></i><p class="seb-empty-title">{{localize "sargas-encounter-builder.party.noProfilesTitle"}}</p><p class="seb-empty-hint">{{localize "sargas-encounter-builder.party.noProfilesHint"}}</p></div>
        {{/each}}
      </div>
    </aside>
    <div class="seb-panel">
      {{#if party.profile}}
      <div class="seb-panel-head">
        <span class="seb-eyebrow">{{party.profile.name}} <span class="seb-text-dim">· {{party.roster.partySize}} {{localize "sargas-encounter-builder.party.counted"}}</span></span>
        <span class="seb-panel-actions">
          <button type="button" class="seb-icon-button" data-action="refreshParty" data-tooltip="{{localize 'sargas-encounter-builder.party.refresh'}}" aria-label="{{localize 'sargas-encounter-builder.party.refresh'}}"><i class="fa-solid fa-rotate"></i></button>
          <button type="button" class="seb-icon-button" data-action="renameProfile" data-tooltip="{{localize 'sargas-encounter-builder.party.rename'}}" aria-label="{{localize 'sargas-encounter-builder.party.rename'}}"><i class="fa-solid fa-pen"></i></button>
          <button type="button" class="seb-icon-button seb-icon-danger" data-action="deleteProfile" data-tooltip="{{localize 'sargas-encounter-builder.party.delete'}}" aria-label="{{localize 'sargas-encounter-builder.party.delete'}}"><i class="fa-solid fa-trash"></i></button>
        </span>
      </div>
      {{#if party.showPolicy}}
      <div class="seb-form-row">
        <div class="seb-field">
          <label for="seb-party-policy">{{localize "sargas-encounter-builder.party.policyLabel"}} <span class="seb-text-dim">({{party.roster.distinctLevels}})</span></label>
          <select id="seb-party-policy" name="referencePolicy">
            <option value="">{{localize "sargas-encounter-builder.party.policy.choose"}}</option>
            {{#each party.policies}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
          </select>
        </div>
        {{#if party.isManual}}<div class="seb-field seb-field-short"><label for="seb-party-manual-level">{{localize "sargas-encounter-builder.party.manualLevel"}}</label><input type="number" id="seb-party-manual-level" name="manualReferenceLevel" min="1" max="20" value="{{party.manualLevel}}"></div>{{/if}}
      </div>
      {{/if}}
      {{#unless party.isLinked}}
      <div class="seb-toolbar">
        <button type="button" class="seb-button seb-button-small" data-action="pickMember"><i class="fa-solid fa-user-plus"></i> {{localize "sargas-encounter-builder.party.pick"}}</button>
        <div class="seb-dropzone" data-purpose="party"><i class="fa-solid fa-hand-pointer"></i> {{localize "sargas-encounter-builder.party.dropHint"}}</div>
      </div>
      {{else}}
      <div class="seb-note"><i class="fa-solid fa-link"></i> {{localize "sargas-encounter-builder.party.linkedHint"}}</div>
      {{/unless}}
      <div class="seb-scroll">
        {{#each party.roster.members}}
        <div class="seb-row {{this.rowClass}}" data-uuid="{{this.uuid}}">
          <i class="fa-solid {{#if this.counted}}fa-circle-check seb-text-accent{{else}}fa-circle seb-text-dim{{/if}} seb-row-icon"></i>
          <div class="seb-row-main">
            <span class="seb-row-name">{{this.name}} <span class="seb-pill">{{this.typeLabel}}</span> <span class="seb-pill is-level">{{localize "sargas-encounter-builder.build.levelShort" level=this.level}}</span></span>
            <span class="seb-row-meta">{{this.statusLabel}}</span>
          </div>
          <div class="seb-row-controls">
            <button type="button" class="seb-icon-button" data-action="toggleMember" data-tooltip="{{localize 'sargas-encounter-builder.party.toggle'}}" aria-label="{{localize 'sargas-encounter-builder.party.toggle'}}" aria-pressed="{{#if this.active}}true{{else}}false{{/if}}"><i class="fa-solid {{#if this.active}}fa-toggle-on{{else}}fa-toggle-off{{/if}}"></i></button>
            {{#if this.canToggleCounts}}<button type="button" class="seb-icon-button" data-action="toggleCounts" data-tooltip="{{localize 'sargas-encounter-builder.party.toggleCounts'}}" aria-label="{{localize 'sargas-encounter-builder.party.toggleCounts'}}" aria-pressed="{{#if this.countsAsMember}}true{{else}}false{{/if}}"><i class="fa-solid {{#if this.countsAsMember}}fa-user-check{{else}}fa-user-slash{{/if}}"></i></button>{{/if}}
            {{#unless ../party.isLinked}}<button type="button" class="seb-icon-button seb-icon-danger" data-action="removeMember" data-tooltip="{{localize 'sargas-encounter-builder.party.remove'}}" aria-label="{{localize 'sargas-encounter-builder.party.remove'}}"><i class="fa-solid fa-xmark"></i></button>{{/unless}}
          </div>
        </div>
        {{else}}
        <div class="seb-empty"><i class="fa-solid fa-user-plus"></i><p class="seb-empty-title">{{localize "sargas-encounter-builder.party.emptyTitle"}}</p><p class="seb-empty-hint">{{localize "sargas-encounter-builder.party.emptyHint"}}</p></div>
        {{/each}}
      </div>
      {{else}}
      <div class="seb-empty"><i class="fa-solid fa-users"></i><p class="seb-empty-title">{{localize "sargas-encounter-builder.party.noProfile"}}</p><p class="seb-empty-hint">{{localize "sargas-encounter-builder.party.noProfileHint"}}</p><button type="button" class="seb-button seb-button-primary" data-action="changeParty"><i class="fa-solid fa-dragon"></i> {{localize "sargas-encounter-builder.party.startDialog"}}</button></div>
      {{/if}}
    </div>
  </div>
</section>
