<section class="seb-tab" id="seb-panel-saved" role="tabpanel" aria-labelledby="seb-tab-saved" data-tab="saved">
  <div class="seb-columns seb-columns-narrow-left">
    <aside class="seb-panel">
      <div class="seb-panel-head">
        <span class="seb-eyebrow">{{localize "sargas-encounter-builder.saved.title"}} <span class="seb-text-dim">· {{saved.records.length}}</span></span>
        <span class="seb-panel-actions"><button type="button" class="seb-button seb-button-primary seb-button-small" data-action="ext" data-ext="saved" data-method="saveCurrent" {{#unless saved.canSave}}disabled{{/unless}}><i class="fa-solid fa-floppy-disk"></i> {{localize "sargas-encounter-builder.saved.saveCurrent"}}</button></span>
      </div>
      <div class="seb-scroll">
        {{#each saved.records}}
        <div class="seb-row seb-row-click{{#if this.selected}} is-selected{{/if}}" role="button" tabindex="0"{{#if this.selected}} aria-current="true"{{/if}} data-action="ext" data-ext="saved" data-method="select" data-uuid="{{this.id}}">
          <i class="fa-solid fa-scroll seb-row-icon"></i>
          <div class="seb-row-main"><span class="seb-row-name">{{this.name}}</span><span class="seb-row-meta">{{this.origin}} · {{localize "sargas-encounter-builder.saved.creatureCount" count=this.count}} · {{this.updated}}</span></div>
          <div class="seb-row-controls"><button type="button" class="seb-icon-button" data-action="ext" data-ext="saved" data-method="open" data-uuid="{{this.id}}" data-tooltip="{{localize 'sargas-encounter-builder.saved.open'}}" aria-label="{{localize 'sargas-encounter-builder.saved.open'}}"><i class="fa-solid fa-folder-open"></i></button></div>
        </div>
        {{else}}
        <div class="seb-empty"><i class="fa-solid fa-box-open"></i><p class="seb-empty-title">{{localize "sargas-encounter-builder.saved.emptyTitle"}}</p><p class="seb-empty-hint">{{localize "sargas-encounter-builder.saved.empty"}}</p></div>
        {{/each}}
      </div>
    </aside>
    <div class="seb-panel seb-panel-raised">
      {{#if saved.selected}}
      <div class="seb-panel-head">
        <span class="seb-eyebrow">{{saved.selected.name}} <span class="seb-text-dim">· {{saved.selected.origin}}{{#if saved.selected.policy}} · {{saved.selected.policy}}{{/if}}</span></span>
        <span class="seb-panel-actions">
          <button type="button" class="seb-icon-button" data-action="ext" data-ext="saved" data-method="editNotes" data-tooltip="{{localize 'sargas-encounter-builder.saved.notesTitle'}}" aria-label="{{localize 'sargas-encounter-builder.saved.notesTitle'}}"><i class="fa-solid fa-note-sticky"></i></button>
          <button type="button" class="seb-icon-button" data-action="ext" data-ext="saved" data-method="rename" data-tooltip="{{localize 'sargas-encounter-builder.saved.renameTitle'}}" aria-label="{{localize 'sargas-encounter-builder.saved.renameTitle'}}"><i class="fa-solid fa-pen"></i></button>
          <button type="button" class="seb-icon-button" data-action="ext" data-ext="saved" data-method="duplicate" data-tooltip="{{localize 'sargas-encounter-builder.saved.duplicate'}}" aria-label="{{localize 'sargas-encounter-builder.saved.duplicate'}}"><i class="fa-solid fa-copy"></i></button>
          <button type="button" class="seb-icon-button seb-icon-danger" data-action="ext" data-ext="saved" data-method="delete" data-tooltip="{{localize 'sargas-encounter-builder.saved.deleteTitle'}}" aria-label="{{localize 'sargas-encounter-builder.saved.deleteTitle'}}"><i class="fa-solid fa-trash"></i></button>
        </span>
      </div>
      {{#if saved.selected.notes}}<div class="seb-note"><i class="fa-solid fa-note-sticky"></i> {{saved.selected.notes}}</div>{{/if}}
      {{#each saved.missing}}<div class="seb-note is-error">{{localize "sargas-encounter-builder.saved.missingEntry" name=this.name uuid=this.uuid}}</div>{{/each}}
      <div class="seb-scroll seb-list">
        {{#each saved.selected.entries}}
        <div class="seb-row"><i class="fa-solid {{#if this.locked}}fa-lock{{else}}fa-skull{{/if}} seb-row-icon"></i><div class="seb-row-main"><span class="seb-row-name">{{this.name}}</span><span class="seb-row-meta">{{localize "sargas-encounter-builder.build.levelShort" level=this.level}}</span></div><div class="seb-row-controls"><span class="seb-pill is-level">× {{this.quantity}}</span></div></div>
        {{/each}}
        {{#if saved.selected.variant}}
        <div class="seb-group-header"><span>{{localize "sargas-encounter-builder.saved.variantOf"}}</span></div>
        <p class="seb-hint">{{#each saved.selected.variant.original}}{{this.name}} × {{this.quantity}}{{#unless @last}}, {{/unless}}{{/each}}</p>
        {{#each saved.selected.variant.diff}}<div class="seb-note is-inline">{{this.changeLabel}}: {{this.name}} {{this.from}} → {{this.to}}</div>{{/each}}
        {{/if}}
      </div>
      <div class="seb-group-header"><span>{{localize "sargas-encounter-builder.saved.savedEvaluation"}}</span></div>
      {{#if saved.selected.evaluation}}{{> "modules/sargas-encounter-builder/templates/builder/snapshot.hbs" snap=saved.selected.evaluation}}{{else}}<p class="seb-hint">{{localize "sargas-encounter-builder.saved.noEvaluation"}}</p>{{/if}}
      <div class="seb-toolbar seb-toolbar-wrap">
        <button type="button" class="seb-button seb-button-primary seb-button-small" data-action="ext" data-ext="saved" data-method="open"><i class="fa-solid fa-folder-open"></i> {{localize "sargas-encounter-builder.saved.open"}}</button>
        <button type="button" class="seb-button seb-button-small" data-action="ext" data-ext="saved" data-method="updateFromDraft" {{#unless saved.canSave}}disabled{{/unless}} data-tooltip="{{localize 'sargas-encounter-builder.saved.updateHint'}}"><i class="fa-solid fa-pen-to-square"></i> {{localize "sargas-encounter-builder.saved.update"}}</button>
        <button type="button" class="seb-button seb-button-small" data-action="ext" data-ext="saved" data-method="recalculate" {{#unless saved.canRecalc}}disabled{{/unless}}><i class="fa-solid fa-calculator"></i> {{localize "sargas-encounter-builder.saved.recalculate"}}</button>
        {{#if saved.recalculated}}<button type="button" class="seb-button seb-button-small" data-action="ext" data-ext="saved" data-method="updateEvaluation"><i class="fa-solid fa-arrow-right-to-bracket"></i> {{localize "sargas-encounter-builder.saved.updateEvaluation"}}</button>{{/if}}
      </div>
      {{#if saved.recalculated}}
      <div class="seb-group-header"><span>{{localize "sargas-encounter-builder.saved.recalculated"}}</span></div>
      {{> "modules/sargas-encounter-builder/templates/builder/snapshot.hbs" snap=saved.recalculated}}
      {{/if}}
      <p class="seb-hint">{{localize "sargas-encounter-builder.saved.created"}}: {{saved.selected.created}} · {{localize "sargas-encounter-builder.saved.updated"}}: {{saved.selected.updated}}{{#if saved.selected.seed}} · {{localize "sargas-encounter-builder.generator.lastSeed"}} {{saved.selected.seed}}{{/if}}</p>
      {{else}}
      <div class="seb-empty"><i class="fa-solid fa-hand-pointer"></i><p class="seb-empty-title">{{localize "sargas-encounter-builder.saved.selectTitle"}}</p><p class="seb-empty-hint">{{localize "sargas-encounter-builder.saved.select"}}</p></div>
      {{/if}}
    </div>
  </div>
</section>
