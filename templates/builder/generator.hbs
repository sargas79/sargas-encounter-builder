{{!-- Themed random generation. Expects `generator`. --}}
<div class="seb-generator">
  <div class="seb-form-row">
    <div class="seb-field seb-field-wide">
      <label for="seb-gen-theme">{{localize "sargas-encounter-builder.generator.theme"}}</label>
      <select id="seb-gen-theme" name="gen.themeId">
        <option value="auto" {{#if generator.autoSelected}}selected{{/if}}>{{localize "sargas-encounter-builder.generator.themeAuto"}}</option>
        <optgroup label="{{localize 'sargas-encounter-builder.generator.themeGroup.custom'}}">
          {{#each generator.themeOptions}}{{#if (eq this.group "custom")}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}} ({{this.size}})</option>{{/if}}{{/each}}
        </optgroup>
        <optgroup label="{{localize 'sargas-encounter-builder.generator.themeGroup.auto'}}">
          {{#each generator.themeOptions}}{{#if (eq this.group "auto")}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}} ({{this.size}})</option>{{/if}}{{/each}}
        </optgroup>
        <optgroup label="{{localize 'sargas-encounter-builder.generator.themeGroup.environment'}}">
          {{#each generator.themeOptions}}{{#if (eq this.group "environment")}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}} ({{this.size}})</option>{{/if}}{{/each}}
        </optgroup>
      </select>
    </div>
    <div class="seb-field seb-field-actions">
      <label>{{localize "sargas-encounter-builder.generator.themes.title"}}</label>
      <div class="seb-inline">
        <button type="button" class="seb-button seb-button-small" data-action="ext" data-ext="generator" data-method="newTheme"><i class="fa-solid fa-palette"></i> {{localize "sargas-encounter-builder.generator.themes.new"}}</button>
        {{#if generator.customThemes.length}}
        <details class="seb-popover">
          <summary class="seb-button seb-button-small"><i class="fa-solid fa-list"></i> {{generator.customThemes.length}}</summary>
          <div class="seb-popover-body">
            {{#each generator.customThemes}}
            <div class="seb-row">
              <div class="seb-row-main"><span class="seb-row-name">{{this.name}}</span><span class="seb-row-meta">{{this.summary}}</span></div>
              <div class="seb-row-controls">
                <button type="button" class="seb-icon-button" data-action="ext" data-ext="generator" data-method="editTheme" data-uuid="{{this.id}}" data-tooltip="{{localize 'sargas-encounter-builder.generator.themes.edit'}}" aria-label="{{localize 'sargas-encounter-builder.generator.themes.edit'}}"><i class="fa-solid fa-pen"></i></button>
                <button type="button" class="seb-icon-button seb-icon-danger" data-action="ext" data-ext="generator" data-method="deleteTheme" data-uuid="{{this.id}}" data-tooltip="{{localize 'sargas-encounter-builder.generator.themes.delete'}}" aria-label="{{localize 'sargas-encounter-builder.generator.themes.delete'}}"><i class="fa-solid fa-trash"></i></button>
              </div>
            </div>
            {{/each}}
          </div>
        </details>
        {{/if}}
      </div>
    </div>
  </div>

  <div class="seb-field">
    <label id="seb-gen-archetype-label">{{localize "sargas-encounter-builder.generator.archetypeLabel"}}</label>
    <div class="seb-segments seb-segments-wrap" role="group" aria-labelledby="seb-gen-archetype-label">
      {{#each generator.archetypes}}<button type="button" class="seb-segment{{#if this.active}} is-active{{/if}}" data-action="ext" data-ext="generator" data-method="setArchetype" data-value="{{this.value}}" data-tooltip="{{this.hint}}" aria-pressed="{{#if this.active}}true{{else}}false{{/if}}">{{this.label}}</button>{{/each}}
    </div>
  </div>

  <div class="seb-toolbar">
    <button type="button" class="seb-button seb-button-primary" data-action="ext" data-ext="generator" data-method="generate" {{#unless generator.canGenerate}}disabled{{/unless}}><i class="fa-solid fa-dice"></i> {{localize "sargas-encounter-builder.generator.generate"}}</button>
    <button type="button" class="seb-button" data-action="ext" data-ext="generator" data-method="regenerate" {{#unless generator.canGenerate}}disabled{{/unless}} data-tooltip="{{localize 'sargas-encounter-builder.generator.regenerateHint'}}"><i class="fa-solid fa-rotate-right"></i> {{localize "sargas-encounter-builder.generator.regenerate"}}</button>
    <button type="button" class="seb-button" data-action="ext" data-ext="generator" data-method="retheme" {{#unless generator.hasResult}}disabled{{/unless}} data-tooltip="{{localize 'sargas-encounter-builder.generator.rethemeHint'}}"><i class="fa-solid fa-wand-magic-sparkles"></i> {{localize "sargas-encounter-builder.generator.retheme"}}</button>
    <span class="seb-spacer"></span>
    <button type="button" class="seb-button seb-button-small" data-action="ext" data-ext="generator" data-method="toggleAdvanced" aria-pressed="{{#if generator.options.showAdvanced}}true{{else}}false{{/if}}"><i class="fa-solid fa-sliders"></i> {{localize "sargas-encounter-builder.generator.advanced"}}</button>
  </div>
  {{#if generator.busy}}<div class="seb-note"><i class="fa-solid fa-spinner fa-spin"></i> {{localize "sargas-encounter-builder.generator.working"}}</div>{{/if}}

  {{#if generator.options.showAdvanced}}
  <div class="seb-form-row seb-advanced">
    <div class="seb-field seb-field-short"><label for="seb-gen-relativemin">{{localize "sargas-encounter-builder.generator.relativeMin"}}</label><input id="seb-gen-relativemin" type="number" name="gen.relativeMin" min="-4" max="4" value="{{generator.options.relativeMin}}"></div>
    <div class="seb-field seb-field-short"><label for="seb-gen-relativemax">{{localize "sargas-encounter-builder.generator.relativeMax"}}</label><input id="seb-gen-relativemax" type="number" name="gen.relativeMax" min="-4" max="4" value="{{generator.options.relativeMax}}"></div>
    <div class="seb-field seb-field-short"><label for="seb-gen-mincount">{{localize "sargas-encounter-builder.generator.minCount"}}</label><input id="seb-gen-mincount" type="number" name="gen.minCount" min="1" max="40" value="{{generator.options.minCount}}"></div>
    <div class="seb-field seb-field-short"><label for="seb-gen-maxcount">{{localize "sargas-encounter-builder.generator.maxCount"}}</label><input id="seb-gen-maxcount" type="number" name="gen.maxCount" min="1" max="40" value="{{generator.options.maxCount}}"></div>
    <div class="seb-field seb-field-short"><label for="seb-gen-duplicatecap">{{localize "sargas-encounter-builder.generator.duplicateCap"}}</label><input id="seb-gen-duplicatecap" type="number" name="gen.duplicateCap" min="1" max="40" value="{{generator.options.duplicateCap}}"></div>
    <div class="seb-field"><label for="seb-gen-seed">{{localize "sargas-encounter-builder.generator.seed"}}</label><input id="seb-gen-seed" type="text" name="gen.seed" value="{{generator.options.seed}}" placeholder="{{localize 'sargas-encounter-builder.generator.seedPlaceholder'}}"></div>
    {{#if generator.isBossMinions}}<label class="seb-checkbox seb-field-wide"><input type="checkbox" name="gen.outsiderBoss" {{#if generator.options.outsiderBoss}}checked{{/if}}> <span>{{localize "sargas-encounter-builder.generator.outsiderBoss"}}</span></label>{{/if}}
    <p class="seb-hint seb-field-wide">{{localize "sargas-encounter-builder.generator.filtersHint"}}{{#if generator.lockedCount}} {{localize "sargas-encounter-builder.generator.lockedHint" count=generator.lockedCount}}{{/if}}</p>
  </div>
  {{/if}}

  {{#if generator.excluded.length}}
  <div class="seb-row-pills seb-excluded"><span class="seb-text-dim">{{localize "sargas-encounter-builder.generator.excluded"}}:</span>{{#each generator.excluded}}<button type="button" class="seb-chip is-active" data-action="ext" data-ext="generator" data-method="unexclude" data-uuid="{{this.uuid}}" data-tooltip="{{localize 'sargas-encounter-builder.generator.unexclude'}}">{{this.name}} <i class="fa-solid fa-xmark"></i></button>{{/each}}</div>
  {{/if}}

  {{#if generator.last}}
    {{#if generator.last.ok}}
    <div class="seb-result">
      <span class="seb-pill is-accent">{{generator.last.themeName}}</span>
      <span class="seb-pill">{{generator.last.archetypeLabel}}</span>
      <span class="seb-pill">{{generator.last.fitLabel}} · {{generator.last.totalXP}}/{{generator.last.target}} XP</span>
      {{#if generator.last.outsider}}<span class="seb-pill is-warn">{{localize "sargas-encounter-builder.generator.outsiderUsed" name=generator.last.outsider}}</span>{{/if}}
      <span class="seb-text-dim">{{localize "sargas-encounter-builder.generator.poolSize" count=generator.last.poolSize}}{{#if generator.lastSeed}} · {{localize "sargas-encounter-builder.generator.lastSeed"}} {{generator.lastSeed}}{{/if}}</span>
    </div>
    {{else}}
    <div class="seb-note is-warn"><i class="fa-solid fa-triangle-exclamation"></i> {{generator.last.reason}}{{#if generator.last.themeName}} <span class="seb-text-dim">({{generator.last.themeName}})</span>{{/if}}</div>
    {{/if}}
  {{/if}}
</div>
