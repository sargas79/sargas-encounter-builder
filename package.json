{
  "name": "sargas-encounter-builder",
  "version": "0.4.2",
  "private": true,
  "description": "GM encounter workspace for the Pathfinder Second Edition system on Foundry VTT",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "handlebars": "^4.7.10",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
